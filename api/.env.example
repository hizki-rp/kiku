# Copy to api/.env on Hostinger (public_html/api/.env). .htaccess blocks web access to it.
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_tomoshibi
DB_PASSWORD=change-me
DB_NAME=u123456789_tomoshibi
# Must be identical to JWT_SECRET on Render. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated web origins allowed to call the API (native apps send no Origin).
CLIENT_ORIGIN=https://tomoshibi.example.com
# Public URL of this api/ folder, used to build audio/lyrics URLs.
PUBLIC_BASE_URL=https://tomoshibi.example.com/api
API_PREFIX=/api
# These usernames become admins when they register/log in. Register them right after deploying.
ADMIN_USERNAMES=admin
