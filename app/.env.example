# Copy to app/.env. Baked into the build at bundle time (public values only, no secrets).
EXPO_PUBLIC_API_URL=https://tomoshibi.example.com/api
EXPO_PUBLIC_SOCKET_URL=https://tomoshibi-socket.onrender.com
# Optional TURN relay for voice chat on strict networks (some mobile carriers). Free tier: metered.ca/openrelay
# EXPO_PUBLIC_TURN_URL=turn:global.relay.metered.ca:80,turns:global.relay.metered.ca:443?transport=tcp
# EXPO_PUBLIC_TURN_USERNAME=
# EXPO_PUBLIC_TURN_CREDENTIAL=
